    {
      "parameters": {
        "jsCode": "// --- n8n Code Node (JavaScript) ---\n// This script takes an array of objects and converts it into a single JSON string.\n\n// 1. Extract the JSON data from all incoming n8n items.\nconst allArticlesArray = items.map(item => item.json);\n\n// 2. Convert the entire array into a single JSON string.\n// The 'null, 2' arguments format the string with indentation for readability.\nconst combinedString = JSON.stringify(allArticlesArray, null, 2);\n\n// 3. Return the result as a single item.\n// The output will have one property, 'fullString', containing the combined text.\nreturn [\n  {\n    json: {\n      fullString: combinedString\n    }\n  }\n];"
      },
      "id": "7ce78950-87ed-47f6-82ce-58d8276b6070",
      "name": "join_articles_into_1",
      "type": "n8n-nodes-base.code",
      "position": [
        896,
        1136
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $input.first().json.output;\nconst outputText = typeof rawOutput === 'string'\n  ? rawOutput.trim()\n  : JSON.stringify(rawOutput);\nconst unfencedOutput = outputText\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\nconst jsonStartIndex = unfencedOutput.indexOf('{');\nconst jsonEndIndex = unfencedOutput.lastIndexOf('}');\n\nif (jsonStartIndex === -1 || jsonEndIndex <= jsonStartIndex) {\n  throw new Error('The AI response did not contain a usable sentiment JSON object.');\n}\n\nconst parsedJson = JSON.parse(unfencedOutput.slice(jsonStartIndex, jsonEndIndex + 1));\n\nif (!parsedJson.symbol || parsedJson.sentiment_score === undefined || !parsedJson.rationale) {\n  throw new Error('The AI response JSON is missing symbol, sentiment_score, or rationale.');\n}\n\nconst staticData = $getWorkflowStaticData('global');\nconst executionId = $execution.id;\n\nstaticData.sentimentDigests ??= {};\nstaticData.sentimentDigests[executionId] ??= [];\nstaticData.sentimentDigests[executionId].push(parsedJson);\n\nreturn [{ json: parsedJson }];"
      },
