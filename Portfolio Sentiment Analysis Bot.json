    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst executionId = $execution.id;\nconst results = staticData.sentimentDigests?.[executionId] ?? [];\nconst reportDate = new Date().toISOString().slice(0, 10);\n\nif (results.length === 0) {\n  return [{ json: { telegramMessage: `Date: ${reportDate}\\n\\nNo sentiment results were generated.` } }];\n}\n\nconst tickerSections = results.map(result => [\n  `Ticker: ${result.symbol ?? 'Unknown'}`,\n  `Sentiment Analysis: ${result.sentiment_score ?? 'N/A'}`,\n  `Rational: ${result.rationale ?? 'No rationale provided.'}`\n].join('\\n'));\n\nconst message = [`Date: ${reportDate}`, ...tickerSections].join('\\n\\n');\nconst maxMessageLength = 3900;\nconst telegramMessage = message.length > maxMessageLength\n  ? `${message.slice(0, maxMessageLength)}\\n\\n[Message truncated]`\n  : message;\n\ndelete staticData.sentimentDigests[executionId];\n\nreturn [{ json: { telegramMessage } }];"
      },
